{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "components/dashboard/SettingsContent.tsx",
    "app/api/workspaces/route.ts",
    "app/api/workspace/[workspaceId]/members/route.ts",
    "app/api/workspace/[workspaceId]/preferences/route.ts"
  ],
  "exclude": ["node_modules"]
}
